<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recommendationsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ScrollView
        android:id="@+id/recommendationsInfoScrollView"
        android:layout_width="190dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingStart="0dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:id="@+id/recommendationsInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recommendationsTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recommendations_screen_title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recommendationsExplanationTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/recommendations_explanation"
                android:textSize="12sp" />

            <Button
                android:id="@+id/recommendationsRefreshButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/recommendations_refresh_button_short"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/recommendationsProgressBar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/recommendationsMessageTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/recommendations_initial_message"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recommendationsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="0dp"
        android:paddingBottom="12dp" />

</LinearLayout>